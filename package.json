{
  "name": "littlefightnyc-workspace",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build",
    "lint": "npm --prefix app run lint",
    "preview": "npm --prefix app run preview",
    "audit:audit": "npm --prefix app run audit:audit",
    "audit:booking": "npm --prefix app run audit:booking",
    "audit:mobile-lifecycle": "npm --prefix app run audit:mobile-lifecycle",
    "audit:repo-boundary": "npm --prefix app run audit:repo-boundary",
    "audit:signal": "npm --prefix app run audit:signal",
    "audit:quality-manifest": "npm --prefix app run audit:quality-manifest",
    "audit:release": "npm --prefix app run audit:release",
    "test:browser": "npm --prefix app run test:browser",
    "quality:fast": "npm run typecheck:functions && npm run test:acquisition && npm --prefix app run quality:fast",
    "quality:full": "npm run typecheck:functions && npm run test:acquisition && npm --prefix app run quality:full",
    "quality:release": "npm run typecheck:functions && npm run test:acquisition && npm --prefix app run quality:release",
    "quality:live": "npm --prefix app run quality:live",
    "quality:maintenance": "npm run typecheck:functions && npm --prefix app run quality:maintenance",
    "typecheck:functions": "./app/node_modules/.bin/tsc -p tsconfig.functions.json",
    "test:acquisition": "vitest run app/src/lib/techAuditContact.test.ts app/src/lib/attribution.test.ts app/src/lib/socialCampaign.test.ts app/src/lib/firstLookWebMcp.test.ts app/src/lib/rum.test.ts netlify/functions/_shared/public-audit/intake.test.ts netlify/functions/_shared/public-audit/cleanup-expired.test.ts && npm run leads:test",
    "leads:test": "node --test app/scripts/lead-reconciliation.test.mjs",
    "leads:help": "node app/scripts/lead-reconciliation.mjs help",
    "leads:summary": "node app/scripts/lead-reconciliation.mjs summary",
    "leads:import": "node app/scripts/lead-reconciliation.mjs import-netlify",
    "leads:import-file": "node app/scripts/lead-reconciliation.mjs import-file",
    "leads:add": "node app/scripts/lead-reconciliation.mjs add",
    "leads:stage": "node app/scripts/lead-reconciliation.mjs stage",
    "leads:exclude": "node app/scripts/lead-reconciliation.mjs exclude",
    "leads:list": "node app/scripts/lead-reconciliation.mjs list",
    "leads:export": "node app/scripts/lead-reconciliation.mjs export-csv"
  },
  "dependencies": {
    "@netlify/blobs": "10.7.13",
    "@netlify/database": "^1.1.0",
    "@netlify/functions": "^5.3.0",
    "nodemailer": "10.0.12"
  },
  "devDependencies": {
    "@netlify/edge-functions": "3.0.8",
    "@types/node": "24.10.1",
    "vitest": "4.1.11"
  }
}
