{
  "name": "littlefightnyc-scratch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "browserslist": [
    "defaults",
    "iOS >= 15",
    "Safari >= 15"
  ],
  "scripts": {
    "predev": "node scripts/split-journal.mjs && node scripts/build-route-meta.mjs && node scripts/build-nav-index.mjs",
    "prebuild": "npm run audit:audit-integrations && npm run audit:repo-boundary && npm run audit:retired-integrations",
    "dev": "vite",
    "generate:social-cards": "node scripts/generate-social-cards.mjs",
    "build": "node scripts/build-tile-measurement.mjs && tsc -b && vite build --config vite.tiles.config.ts && python3 scripts/build-tile-preview.py --production && node scripts/vera-prerender.mjs && node scripts/write-release-metadata.mjs && python3 scripts/finalize-tile-artifact.py",
    "postbuild": "python3 scripts/audit-tile-content.py --dist dist && npm run audit:retired-product",
    "lint": "eslint .",
    "audit:audit": "node scripts/audit-audit-archive.mjs",
    "audit:audit-integrations": "node scripts/audit-audit-integrations.mjs",
    "audit:booking": "node scripts/audit-booking-bridge.mjs",
    "audit:bundle": "node scripts/audit-marketing-bundle.mjs",
    "audit:conversion": "node scripts/audit-conversion-contract.mjs",
    "audit:lab": "node scripts/audit-lab-archive.mjs",
    "audit:mobile-lifecycle": "node scripts/audit-mobile-lifecycle.mjs",
    "audit:repo-boundary": "node scripts/audit-repo-boundary.mjs",
    "audit:signal": "node scripts/audit-signal.mjs",
    "audit:brand": "node scripts/audit-brand-system.mjs",
    "audit:metadata": "node scripts/audit-metadata-parity.mjs",
    "audit:integrity": "node scripts/audit-site-integrity.mjs",
    "audit:llm-coercion": "node scripts/audit-llm-coercion.mjs",
    "audit:vera-csp": "node scripts/audit-vera-csp.mjs",
    "audit:vera-legal": "node scripts/audit-vera-legal-content.mjs",
    "audit:retired-integrations": "node scripts/audit-retired-integrations.mjs",
    "audit:case-explorer": "node scripts/audit-case-study-explorer.mjs",
    "audit:retired-product": "node scripts/audit-retired-product-dist.mjs",
    "audit:quality-manifest": "node scripts/audit-quality-manifest.mjs",
    "audit:release": "node scripts/audit-release-readiness.mjs",
    "test:browser": "playwright test",
    "test:vera-data-edge": "node --experimental-strip-types scripts/test-vera-data-edge.mjs",
    "test:vera-service-worker": "node scripts/test-vera-service-worker.mjs",
    "test:owner-math": "node scripts/test-owner-math.mjs",
    "test:release-contract": "node scripts/test-write-release-metadata.mjs && node scripts/test-redirects.mjs && node --experimental-strip-types scripts/test-retired-host-response.mjs && node scripts/test-indexnow-release.mjs",
    "test:browser:chromium": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "quality": "npm run quality:fast && npm run quality:tile-functional",
    "quality:fast": "npm run lint && npm run build && npm run quality:tile-artifact",
    "quality:full": "npm run quality && npm run audit:quality-manifest",
    "quality:release": "npm run quality:fast && npm run audit:quality-manifest && npm run quality:tile-release",
    "quality:live": "node scripts/verify-live.mjs",
    "quality:maintenance": "npm run quality:full && npm audit --omit=dev --audit-level=high && npm run audit:external-links",
    "preview": "vite preview",
    "audit:legal-snapshot": "node scripts/audit-legal-snapshot.mjs",
    "audit:meta-budget": "node scripts/audit-meta-description-budget.mjs",
    "audit:external-links": "node scripts/audit-external-links.mjs",
    "audit:claim-scope": "node scripts/audit-claim-scope.mjs",
    "audit:typography": "node scripts/audit-typography.mjs",
    "audit:agency-voice": "node scripts/audit-agency-voice.mjs",
    "audit:copy-contract": "node scripts/audit-copy-contract.mjs",
    "audit:visual-coverage": "node scripts/audit-visual-coverage.mjs",
    "indexnow:plan": "node scripts/indexnow-release.mjs --dry-run",
    "indexnow:submit": "node scripts/indexnow-release.mjs --submit --confirm-production",
    "build:tile-preview": "python3 scripts/build-tile-preview.py",
    "audit:tiles": "python3 scripts/audit-tile-content.py --dist dist",
    "test:tile-browser": "node scripts/verify-tile-preview.cjs",
    "test:tile-production": "node scripts/verify-tile-production.cjs",
    "quality:tile-artifact": "node scripts/quality-tiles.mjs --dist dist",
    "quality:tile-functional": "node scripts/quality-tiles.mjs --dist dist --functional",
    "quality:tile-release": "node scripts/quality-tiles.mjs --dist dist --release"
  },
  "dependencies": {
    "@fontsource-variable/oswald": "^5.2.8",
    "@fontsource/barlow": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "i18next": "^26.3.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.10",
    "react-router-dom": "7.18.2",
    "web-vitals": "6.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.62.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.25",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.2"
  }
}
